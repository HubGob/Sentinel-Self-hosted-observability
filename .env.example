# Database
DATABASE_URL=postgresql+psycopg://sentinel:sentinel@postgres:5432/sentinel

# Redis
REDIS_URL=redis://redis:6379/0

# API
API_HOST=0.0.0.0
API_PORT=8000

# Worker
WORKER_POLL_INTERVAL=1.0
WORKER_BATCH_SIZE=100

# Collector
COLLECTOR_ENABLED=true

# Logging
LOG_LEVEL=INFO

# Auth
# Generate a real one with: openssl rand -hex 32
# Without it, tokens are signed with a default that is published in this
# repository, so anyone can mint valid tokens for your deployment.
JWT_SECRET=replace-me-openssl-rand-hex-32
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=7
